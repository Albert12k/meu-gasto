{
  "name": "gastofacil",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "ts.check": "tsc",
    "test": "jest"
  },
 "jest": {
    "preset": "jest-expo",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node",
      "mjs"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|react-native-reanimated|firebase|@firebase)"
    ],
    "moduleNameMapper": {
      "^react-native-worklets/plugin$": "<rootDir>/node_modules/react-native/jest/mockComponent.js",
      "^react-native-reanimated/plugin$": "<rootDir>/node_modules/react-native/jest/mockComponent.js",
      "^@expo/vector-icons$": "<rootDir>/node_modules/react-native/jest/mockComponent.js"
    }
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "@react-navigation/stack": "^7.8.11",
    "date-fns": "^4.1.0",
    "expo": "~54.0.33",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.13.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.4"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "babel-jest": "^29.2.1",
    "babel-preset-expo": "^55.0.22",
    "jest": "^29.2.1",
    "jest-expo": "^55.0.18",
    "react-native-worklets": "^0.8.3",
    "react-test-renderer": "^19.1.0"
  }
}
